PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_SESSION_SECRET=change-this-to-at-least-32-random-characters
COOKIE_SECURE=false
